# ===== Kooka – configuration =====

# Public address of the app (used in email links, the OIDC callback and the Google Calendar feed).
# Google Calendar must be able to reach it from the internet to read the feed.
KOOKA_URL=https://kooka.example.com

# Time zone (dates and times of appointments, hour of the reminder emails)
TZ=Europe/Rome
# Hour (0-23) after which the daily reminder email is sent; also the default hour of push reminders
KOOKA_REMINDER_HOUR=8

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
KOOKA_SIGNUP=open

# In production behind HTTPS: cookies only over secure connections
KOOKA_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
KOOKA_PROXY=1

# Email (address confirmation, password recovery and daily reminders). Without SMTP emails are only written to the log.
KOOKA_SMTP_HOST=
KOOKA_SMTP_PORT=587
KOOKA_SMTP_USER=
KOOKA_SMTP_PASSWORD=
KOOKA_MAIL_FROM=Kooka <noreply@example.com>

# Email/password sign-in and sign-up. Set to 0 to allow only the OIDC providers below (configure at least one).
KOOKA_PASSWORD_LOGIN=1

# Sign-in with external providers (OpenID Connect), comma separated. Leave empty to disable.
# Callback URL to register with the provider: <KOOKA_URL>/api/oidc/<name>/callback
KOOKA_OIDC=
# Google (console.cloud.google.com → Credentials → OAuth client ID, "Web application")
KOOKA_OIDC_GOOGLE_ID=
KOOKA_OIDC_GOOGLE_SECRET=
# Any other OIDC provider, e.g. KOOKA_OIDC=google,microsoft
# KOOKA_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# KOOKA_OIDC_MICROSOFT_ID=
# KOOKA_OIDC_MICROSOFT_SECRET=
# KOOKA_OIDC_MICROSOFT_NAME=Microsoft
# Self-hosted providers work the same way, e.g. KOOKA_OIDC=authentik
# KOOKA_OIDC_AUTHENTIK_ISSUER=https://auth.example.com/application/o/kooka
# KOOKA_OIDC_AUTHENTIK_ID=
# KOOKA_OIDC_AUTHENTIK_SECRET=
# KOOKA_OIDC_AUTHENTIK_NAME=Authentik

# How many daily automatic database backups to keep
KOOKA_BACKUP_KEEP=30

# ----- Wombat: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as Wombat) and the family, its
# members and people are managed in Wombat. Key: the same as WOMBAT_APP_KOOKA_KEY in Wombat.
KOOKA_HUB_URL=
KOOKA_HUB_KEY=
# Address of Wombat for people (links), if different from KOOKA_HUB_URL (e.g. an internal Docker address)
KOOKA_HUB_PUBLIC_URL=
